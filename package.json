{
  "name": "@aurafhe/mcp",
  "version": "0.5.0-preview.1",
  "description": "Ciphertext-only MCP server with separate owner tooling. Developer preview; native confidentiality release gate remains blocked.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp": "dist/index.js",
    "aura-fhe": "dist/index.js",
    "aura-fhe-mcp": "dist/index.js",
    "aura-owner": "dist/owner-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/owner-cli.js",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --import tsx --test src/*.test.ts",
    "start": "node dist/index.js",
    "connect": "tsx examples/connect/connect.ts",
    "connect:github": "tsx examples/connect/connect.ts --github",
    "check": "bash scripts/check-network.sh",
    "launch": "bash scripts/launch.sh",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "test:live": "node scripts/strict-live.mjs",
    "test:native": "python3 native/run_integration.py"
  },
  "keywords": [
    "mcp-server",
    "mcp",
    "model-context-protocol",
    "agents",
    "tools",
    "fhe",
    "ai",
    "private-ai",
    "homomorphic",
    "aura",
    "encrypted-compute",
    "cursor",
    "claude"
  ],
  "author": "Mochi Labs <gen@afhe.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aurafhe-official/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/aurafhe-official/mcp/issues"
  },
  "homepage": "https://afhe.io",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "optionalDependencies": {
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
